{
  "name": "agents-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adaptive agent orchestrator over Gemini — one command to install and run.",
  "bin": {
    "agents-orchestrator": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist dist-tsc",
    "start": "node dist/cli.js",
    "smoke-test": "node scripts/smoke-test.mjs",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@google/genai": "^2.20.0",
    "@napi-rs/keyring": "^2.0.0",
    "fastify": "^5.6.1",
    "jsonc-parser": "^3.3.1",
    "pino": "^10.3.1",
    "ws": "^8.18.3",
    "yaml": "2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ao/core": "workspace:*",
    "@ao/platform": "workspace:*",
    "@ao/providers": "workspace:*",
    "@ao/runtime": "workspace:*",
    "@ao/shared": "workspace:*",
    "@ao/tools": "workspace:*",
    "@ao/web": "workspace:*",
    "@types/node": "^26.4.0",
    "esbuild": "^0.25.0"
  }
}
